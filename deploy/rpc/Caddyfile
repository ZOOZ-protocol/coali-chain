{
	email {$ACME_EMAIL}
}

# Security headers shared by every site. The pages use small inline scripts, so scripts may be
# inline but never come from another origin.
(headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
}

# Argument: the image sources besides the site itself.
(csp) {
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' {args[0]}; connect-src 'self' https://rpc.{$DOMAIN} wss://rpc.{$DOMAIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
}

# Dotfiles and deployment files are never served (single-page fallbacks would otherwise answer 200).
(hidden) {
	@hidden path /.* */.* /Caddyfile /docker-compose.yml /Dockerfile /*.env /*.env.* /*.service /package.json /package-lock.json
	handle @hidden {
		respond 404
	}
}

{$DOMAIN} {
	import headers
	import csp data:
	import hidden
	handle /coali-testnet-raw.json {
		root * /srv/spec
		file_server
	}
	handle_path /downloads/* {
		root * /srv/downloads
		file_server
	}
	handle {
		root * /srv/site
		try_files {path} {path}.html
		file_server
	}
}

rpc.{$DOMAIN} {
	import headers
	# The node does not trust proxy headers; never let a visitor's own pass through either.
	reverse_proxy rpc:9944 {
		header_up -Forwarded
		header_up -X-Real-IP
		header_up -X-Forwarded-For
	}
}

explorer.{$DOMAIN} {
	import headers
	# NFT images live on other hosts (IPFS gateways…) and are only loaded on request.
	import csp "data: https:"
	import hidden
	handle /api/* {
		reverse_proxy scan:8090
	}
	handle {
		root * /srv/explorer
		try_files {path} /index.html
		file_server
	}
}

apps.{$DOMAIN} {
	import headers
	import hidden
	@root {
		path /
		not query rpc=*
	}
	redir @root /?rpc=wss://rpc.{$DOMAIN}#/explorer
	reverse_proxy explorer:80
}

faucet.{$DOMAIN} {
	import headers
	import csp data:
	import hidden
	reverse_proxy faucet:8080
}
